# Optional. Without it, user profiles don't persist between server
# restarts (they still work within a session). Location search, hospitals
# and the map need no key at all — they run on free, keyless OpenStreetMap
# services (Nominatim + Overpass), not Google.
DATABASE_URL=

# Optional. Without it, "Explain this alert simply" still works via the
# built-in offline glossary — this just adds a one-time AI rewrite of the
# alert's own headline, cached on-device for 5 days after the first call.
ANTHROPIC_API_KEY=
